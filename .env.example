# Firebase Configuration
# Get these from: Firebase Console > Project Settings > Your apps > Web app config
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Meta Model API
# Get your key from: https://api.meta.ai > Billing & API Keys
# IMPORTANT: Set a spend limit on the Billing page before running the app on device.
# Base URL is https://api.meta.ai/v1 — do not change unless Meta issues a migration notice.
EXPO_PUBLIC_META_API_KEY=your_meta_model_api_key_here
EXPO_PUBLIC_META_API_ENDPOINT=https://api.meta.ai/v1

# Ranti App Config
EXPO_PUBLIC_DEFAULT_USER_ID=demo-user-1
